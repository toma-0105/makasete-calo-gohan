<div class="flex-1 flex flex-col items-center justify-center px-4">
  <div class="w-full max-w-sm">

    <h2 class="text-2xl font-bold text-center mb-8">パスワードをお忘れの方</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "shared/error_messages", resource: resource %>

      <div class="mb-6">
        <%= f.label :email, "メールアドレス", class: "block text-sm mb-1" %>
        <%= f.email_field :email,
            placeholder: "example@mail.com",
            autofocus: true,
            autocomplete: "email",
            class: "input w-full bg-yellow-50 border-yellow-200 placeholder:text-gray-500" %>
      </div>

      <div class="mb-3">
        <%= f.submit "再設定メールを送信する",
            class: "btn w-full bg-yellow-400 hover:bg-yellow-500 border-none text-white font-bold" %>
      </div>
    <% end %>

    <div>
      <%= link_to "ログイン画面に戻る", new_user_session_path,
          class: "btn w-full bg-white border-yellow-400 text-yellow-500 hover:bg-yellow-50" %>
    </div>
  </div>
</div>
