<div class="flex-1 flex flex-col items-center justify-center px-4">
  <div class="w-full max-w-sm">

    <h2 class="text-2xl font-bold text-center mb-8">新しいパスワードを設定</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="mb-4">
        <%= f.label :password, "新しいパスワード", class: "block text-sm mb-1" %>
        <%= f.password_field :password,
            placeholder: @minimum_password_length ? "#{@minimum_password_length}文字以上" : "新しいパスワード",
            autofocus: true,
            autocomplete: "new-password",
            class: "input w-full bg-yellow-50 border-yellow-200 placeholder:text-gray-500" %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "block text-sm mb-1" %>
        <%= f.password_field :password_confirmation,
            placeholder: "もう一度入力",
            autocomplete: "new-password",
            class: "input w-full bg-yellow-50 border-yellow-200 placeholder:text-gray-500" %>
      </div>

      <div class="mb-3">
        <%= f.submit "パスワードを変更する",
            class: "btn w-full bg-yellow-400 hover:bg-yellow-500 border-none text-white font-bold" %>
      </div>
    <% end %>
  </div>
</div>
