<%# badge は任意の引数。渡されなくてもエラーにならないよう local_assigns で判定する %>
<div class="bg-[#FFF8C4] border border-[#EAE070] rounded-xl p-4">
  <p class="text-[14px] font-semibold text-[#2a2810] mb-0.5">
    <%= title %>
    <% if local_assigns[:badge] %>
      <span class="text-[10px] px-1.5 py-0.5 rounded-[10px] bg-[#FFF3A0] text-[#5a4a10] ml-1.5"><%= badge %></span>
    <% end %>
  </p>
  <p class="text-[12px] text-[#7a7550] leading-[1.6]"><%= yield %></p>
</div>
