<% content_for :title, "生成した献立 - まかせてカロごはん" %>

<div class="flex-1 flex flex-col">
  <main class="flex-1 px-5 py-6 max-w-sm mx-auto w-full">

    <h1 class="text-[20px] font-bold text-[#2a2810] mb-1"><%= @menus.size %>日分の献立を生成しました</h1>
    <p class="text-[13px] text-[#9a9570] mb-5">
      日付をタップすると、朝・昼・夕の料理が開きます。<br>
      保存や再生成は、開いた中の「詳細・保存へ」から行えます。
    </p>

    <% if @menus.any? %>
      <div class="flex flex-col gap-3">
        <%= render partial: "menu_accordion", collection: @menus, as: :menu %>
      </div>
    <% else %>
      <div class="bg-[#FFF8C4] border border-[#EAE070] rounded-xl p-6 text-center">
        <p class="text-[14px] text-[#5a5530]">献立が見つかりませんでした</p>
      </div>
    <% end %>

    <%# マイページは会員限定のため、ゲストはホーム（診断結果）へ戻す %>
    <% back_label = current_user.guest? ? "診断結果に戻る" : "マイページに戻る" %>
    <div class="mt-6">
      <%= link_to back_label, home_path_for(current_user),
            class: secondary_button_classes("block w-full") %>
    </div>
  </main>
</div>
