<% content_for :title, "今日の献立 - まかせてカロごはん" %>

<div class="flex-1 flex flex-col">
  <main class="flex-1 px-5 py-6 max-w-sm mx-auto w-full">
    <%= render "shared/back_link", fallback_path: home_path_for(current_user) %>
    <h1 class="text-[20px] font-bold text-[#2a2810] mb-1">今日の献立</h1>

    <p class="text-[13px] text-[#9a9570] mb-5"><%= @menu.date.strftime("%Y年%m月%d日") %></p>
    <%# 合計カロリーカード %>
    <div class="bg-[#FFF8C4] border border-[#EAE070] rounded-xl p-4 mb-5 text-center">
      <p class="text-[11px] text-[#9a9570] font-medium mb-1">合計カロリー</p>
      <p class="text-[28px] font-bold text-[#2a2810]">
        <%= number_with_delimiter(@menu.total_calories.to_i) %>
        <span class="text-[14px] font-normal text-[#7a7550]">kcal</span>
      </p>

      <%# 目標カロリーとの比較 %>
      <% if @tdee_profile %>
        <% diff = @menu.total_calories.to_i - @tdee_profile.target_calories.to_i %>
        <div class="mt-2 pt-2 border-t border-[#EAE070] flex justify-center gap-4">
          <p class="text-[11px] text-[#9a9570]">
            目標: <span class="font-medium text-[#5a5530]"><%= number_with_delimiter(@tdee_profile.target_calories.to_i) %> kcal</span>
          </p>
          <p class="text-[11px]">
            差分:
            <span class="font-medium <%= diff > 0 ? 'text-red-500' : 'text-[#4a8c5c]' %>">
              <%= diff > 0 ? '+' : '' %><%= number_with_delimiter(diff) %> kcal
            </span>
          </p>
        </div>
      <% end %>
    </div>

    <%# 朝食・昼食・夕食（各食の中は 主食 → 主菜 → 副菜 → 汁物 の順。並び順はMenusHelperで決める） %>
    <% meals_grouped_by_timing(@menu).each do |label, meals| %>
      <div class="mb-4">
        <h2 class="text-[14px] font-bold text-[#2a2810] mb-2"><%= label %></h2>
        <div class="bg-white border border-[#EAE070] rounded-xl divide-y divide-[#F0ECC4]">
          <% meals.each do |meal| %>
            <div class="px-4 py-3">
              <div class="flex justify-between items-center">
                <p class="text-[14px] text-[#3a3820]">
                  <%# グラム調整の料理は換算後のグラム数で表示する（例: ご飯(225g)） %>
                  <%= meal_display_name(meal) %>
                  <%# 個数調整の料理は「×2」ラベルを付ける（例: 納豆1パック ×2） %>
                  <% if (scale_label = meal_scale_label(meal)) %>
                    <span class="text-[11px] text-[#b8860b] font-medium"><%= scale_label %></span>
                  <% end %>
                </p>
                <div class="flex items-center gap-2 shrink-0 ml-2">
                  <p class="text-[15px] text-[#3a3820]">
                    <%= number_with_delimiter(meal.calories.to_i) %> <span class="text-[11px] font-normal text-[#9a9570]">kcal</span>
                  </p>
                  <%# ★と入れ替えマークは、押せる範囲が重ならないよう間隔を広げてまとめる %>
                  <div class="flex items-center gap-5">
                    <%# お気に入り登録・解除（会員のみ表示。ゲストには表示しない） %>
                    <% unless current_user.guest? %>
                      <% favorited = @favorite_meal_master_ids.include?(meal.meal_master_id) %>
                      <%= form_with url: meal_master_favorite_path(meal.meal_master), method: (favorited ? :delete : :post) do |f| %>
                        <%= f.submit favorited ? "★" : "☆",
                              class: "p-3 -m-3 bg-transparent border-none cursor-pointer text-[18px] leading-none transition hover:scale-110 active:scale-95 #{favorited ? 'text-[#F9C639] hover:text-[#d4a317]' : 'text-[#9a9570] hover:text-[#F9C639]'}" %>
                      <% end %>
                    <% end %>
                    <%# この1品だけ入れ替える（ゲストにも表示する）。同じ画面に戻るので履歴は置き換える %>
                    <%= form_with url: regenerate_menu_meal_path(@menu, meal), data: { turbo_action: "replace" } do |f| %>
                      <%= f.button type: "submit",
                            title: "この品を入れ替える",
                            aria: { label: "#{meal.meal_master.name}を入れ替える" },
                            class: "p-2 -m-2 bg-transparent border-none cursor-pointer leading-none text-[#9a9570] transition hover:scale-110 hover:text-[#b8860b] active:scale-95" do %>
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
                        </svg>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>

              <%# カロリーの内訳としてPFCを表示する（データがある料理のみ） %>
              <% if meal.meal_master.protein.present? %>
                <p class="text-[11px] text-[#9a9570] text-left mt-0.5">
                  たんぱく質<%= meal.meal_master.protein.to_i %>g　脂質<%= meal.meal_master.fat.to_i %>g　炭水化物<%= meal.meal_master.carbohydrate.to_i %>g
                </p>
              <% end %>

              <%# アレルギー表示はレシピの有無に関係なく、アレルゲンが登録されている全ての料理で表示する
                  meal_ingredients・allergen_masters（先読み対象）の両方を、
                  結果が空でも必ず一度読み込むことで、Bulletの「先読みしたが未使用」誤検知を防ぐ %>
              <% meal.meal_master.meal_ingredients.to_a %>
              <% allergen_names = meal.meal_master.allergen_masters.map(&:name) %>
              <% if allergen_names.any? %>
                <p class="text-[11px] text-orange-500 mt-0.5">
                  アレルギー表示: <%= allergen_names.join("、") %>
                </p>
              <% end %>

              <%# レシピ（材料・手順）はデータがある料理のみ表示する %>
              <% if meal.meal_master.ingredients.present? %>
                <details class="mt-2 group">
                  <summary class="text-[11px] text-[#b8860b] cursor-pointer select-none list-none flex items-center gap-1">
                    <span class="inline-block transition-transform group-open:rotate-90">▶</span> レシピを見る
                  </summary>
                  <div class="mt-2 pl-1 text-[12px] text-[#5a5530] space-y-2">
                    <div>
                      <p class="font-medium text-[#3a3820]">材料</p>
                      <ul class="list-disc list-inside">
                        <% meal.meal_master.ingredients.each do |ingredient| %>
                          <li><%= ingredient["name"] %>（<%= ingredient["amount"] %>）</li>
                        <% end %>
                      </ul>
                    </div>

                    <div>
                      <p class="font-medium text-[#3a3820]">作り方</p>
                      <ol class="list-decimal list-inside">
                        <% meal.meal_master.steps.each do |step| %>
                          <li><%= step %></li>
                        <% end %>
                      </ol>
                    </div>
                  </div>
                </details>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ボタンエリア %>
    <div class="mt-6 flex flex-col gap-3" data-controller="loading">
      <%# ローディングオーバーレイ %>
      <div data-loading-target="overlay"
          class="hidden fixed inset-0 bg-[#FFFEF5]/90 flex flex-col items-center justify-center z-50">
        <div class="w-12 h-12 border-4 border-[#EAE070] border-t-[#F9C639] rounded-full animate-spin mb-4"></div>
        <p class="text-[15px] font-semibold text-[#3a3820]">献立を生成しています...</p>
        <p class="text-[12px] text-[#9a9570] mt-1">少しお待ちください</p>
      </div>

      <%# 保存ボタン（会員のみ表示。ゲストには表示しない） %>
      <% unless current_user.guest? %>
        <% if @menu.saved? %>
          <p class="block w-full bg-[#F0ECC4] text-[#7a7550] text-center py-3.5 rounded-lg text-[14px] font-medium">
            保存済みの献立です
          </p>
        <% else %>
          <%= form_with url: save_menu_path(@menu), method: :patch do |f| %>
            <%= f.submit "この献立を保存する",
                  class: primary_button_classes("block w-full") %>
          <% end %>
        <% end %>
      <% end %>

      <%# 再生成ボタンと新規登録CTA（ゲストのみ）を横並びで表示 %>
      <div class="flex gap-3">
        <%= form_with url: regenerate_menu_path(@menu),
              data: { action: "submit->loading#showLoading", turbo_action: "replace" }, class: "flex-1" do |f| %>
          <%= f.submit "献立を再生成する",
              class: secondary_button_classes("block w-full") %>
        <% end %>

        <% if current_user.guest? %>
          <%= link_to "はじめよう！", new_guest_promotion_path, class: primary_button_classes("flex-1 text-center") %>
        <% end %>
      </div>
    </div>
  </main>
</div>
