<!DOCTYPE html>
<html>
  <head>
    <% if Rails.env.production? %>
      <%= render "shared/google_analytics" %>
    <% end %>
    <title><%= content_for(:title) || "まかせてカロごはん" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/ogp" %>

    <%= yield :head %>
    <%# アイコン関連 %>
    <%= favicon_link_tag "favicon-32x32.png", type: "image/png" %>
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <%# min-h-screenとflexで「ヘッダー・本文・フッター」を縦に並べ、本文(flex-1)が余白を埋めることでフッターを最下部に固定する %>
  <body class="bg-[#FFFEF5] min-h-screen flex flex-col">
    <%= render "shared/header" %>
    <%= render "shared/flash" %>
    <%= yield %>
    <%= render "shared/footer" %>
  </body>
</html>
