<% content_for :title, "体重記録 - まかせてカロごはん" %>

<div class="flex-1 flex flex-col">
  <main class="flex-1 px-5 py-10 max-w-sm mx-auto w-full">
    <h1 class="text-[20px] font-bold text-[#2a2810] mb-8">体重記録</h1>

    <%# 体重入力フォーム %>
    <div class="card bg-[#FFF8C4] border border-[#EAE070] rounded-xl mb-5">
      <div class="card-body p-5 gap-2">
        <%= form_with model: @weight_record, url: weight_records_path do |f| %>
          <div class="mb-3">
            <%= f.label :recorded_on, "記録日", class: "block text-[13px] text-[#7a7550] mb-1" %>
            <%= f.date_field :recorded_on, value: Date.current, class: "input input-bordered w-full bg-[#FFFEF5]" %>
          </div>
          <div class="mb-3">
            <%= f.label :weight, "体重(kg)", class: "block text-[13px] text-[#7a7550] mb-1" %>
            <%= f.number_field :weight, step: 0.1, class: "input input-bordered w-full bg-[#FFFEF5]" %>
          </div>
          <%= f.submit "記録する", class: primary_button_classes("block w-full") %>
        <% end %>
      </div>
    </div>

    <%# 体重推移グラフ %>
    <% if @chart_data.any? %>
      <div class="card bg-[#FFF8C4] border border-[#EAE070] rounded-xl mb-5">
        <div class="card-body p-5 gap-2">
          <p class="text-[14px] font-bold text-[#2a2810]">体重推移</p>
          <%= line_chart @chart_data, colors: [ "#F9C639" ] %>
        </div>
      </div>
    <% end %>

    <%# 記録履歴 %>
    <% if @weight_records.any? %>
      <div class="card bg-[#FFF8C4] border border-[#EAE070] rounded-xl mb-5">
        <div class="card-body p-5 gap-2">
          <p class="text-[14px] font-bold text-[#2a2810]">記録履歴</p>
          <ul class="text-[13px] text-[#7a7550]">
            <% @weight_records.reverse_each do |record| %>
              <li class="flex justify-between border-b border-[#EAE070] py-1">
                <span><%= record.recorded_on.strftime("%Y/%m/%d") %></span>
                <span class="font-bold text-[#3a3820]"><%= record.weight %>kg</span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>
  </main>
</div>