<% content_for :title, "TDEE診断結果 - まかせてカロごはん" %>

<%# 目標カロリーの割合は service の定数から生成する（係数を変えても表示がズレないように） %>
<% target_ratio_percent = number_to_percentage(TdeeCalculatorService::TARGET_CALORIE_RATIO * 100, precision: 0) %>

<div class="flex-1 flex flex-col items-center justify-center px-4 py-8">
  <div class="w-full max-w-sm">

    <h1 class="text-2xl font-bold text-center mb-2">あなたの1日の目標カロリー</h1>
    <p class="text-sm text-center text-[#7a7550] mb-8">
      この数字をもとに、あなたに合った食事を提案します
    </p>

    <%# 目標カロリー（この画面の主役） %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-8 text-center mb-4">
      <p class="text-6xl font-bold text-[#3d6b35] mb-2">
        <%= number_with_delimiter(@tdee_profile.target_calories.to_i) %>
      </p>
      <p class="text-sm text-[#7a7550]">kcal / 日</p>
    </div>

    <%# TDEE（目標カロリーの根拠）。主役より目立たせないよう太字・緑にはしない %>
    <div class="bg-white border border-[#EAE070] rounded-xl px-4 py-3 mb-6 text-[13px] text-[#5a5530] leading-relaxed">
      <p>
        あなたの消費カロリー（TDEE）は
        <span class="text-[#7a7550]"><%= number_with_delimiter(@tdee_profile.tdee.to_i) %> kcal</span>
        です。<br>
        無理なく体重を落としていくために、消費カロリーの<%= target_ratio_percent %>を目標にしています。
      </p>
    </div>

    <%# ボタン %>
    <div class="flex flex-col gap-3">
      <%= button_to "献立を生成する", menus_path,
          class: "btn w-full bg-yellow-400 hover:bg-yellow-500 border-none text-white font-bold text-center" %>

      <%# マイページへ（会員限定のためゲストには表示しない） %>
      <% unless current_user.guest? %>
        <%= link_to "マイページへ",
            mypage_path,
            class: "btn w-full bg-white hover:bg-gray-50 border border-gray-300 text-gray-700 font-bold text-center" %>
      <% end %>
    </div>
  </div>
</div>
